<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net6.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<Version>6.0.0.0</Version>
		<AssemblyName>Test.PackageClient</AssemblyName>
		<ApplicationIcon>main.ico</ApplicationIcon>
		<PackageIcon>main.ico</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Log.xshd" />
		<None Remove="消息头\0默认样例.json" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Images/*" />
		<Content Include="消息头\*.json">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<EmbeddedResource Include="Log.xshd" />
		<EmbeddedResource Include="main.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AvalonEdit" Version="6.1.3.50" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ICE.Communicator.ServerAndClient\ICE.Communicator.ServerAndClient.csproj" />
		<ProjectReference Include="..\Solomon.Logger\Solomon.Logger.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="main.ico">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
