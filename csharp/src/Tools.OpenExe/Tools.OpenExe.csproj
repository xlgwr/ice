	<Target Condition="'$(TargetFramework)' == 'net48'" Name="AfterResolveReferencesAdd" AfterTargets="AfterResolveReferences">
		<ItemGroup>
			<EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' And !$([System.Text.RegularExpressions.Regex]::IsMatch(&#xD;&#xA;        '%(ReferenceCopyLocalPaths.Filename)', '^System'))">
				<LogicalName>%(ReferenceCopyLocalPaths.DestinationSubDirectory)%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)</LogicalName>
			</EmbeddedResource>
			<Message Text="Project File Name = $(MSBuildProjectFile)" />
			<Message Text="Project Extension = $(MSBuildProjectExtension)" />
		</ItemGroup>
	</Target>
	<Target Condition="'$(TargetFramework)' == 'net48'" Name="DeleteOtherFile" AfterTargets="AfterBuild">

		<Message Text="Project File Name = $(MSBuildProjectFile)" />
		<Message Text="Project Extension = $(MSBuildProjectExtension)" />

		<ItemGroup>
			<!--<OtherFiles Include="$(OutputPath)\*;" Exclude="$(OutputPath)\$(AssemblyName).exe;$(OutputPath)\$(AssemblyName).exe.config;$(OutputPath)\$(AssemblyName).dll;$(OutputPath)\$(AssemblyName).dll.config;$(OutputPath)\OpenExeConfig.json;$(OutputPath)\$(AssemblyName).deps.json;$(OutputPath)\$(AssemblyName).runtimeconfig.json;$(OutputPath)\$(AssemblyName).runtimeconfig.dev.json;$(OutputPath)\方案\*;$(OutputPath)\Solomon.Logger.dll;$(OutputPath)\Solomon.Communicator.ServerAndClient.dll;$(OutputPath)\Ice.dll" />-->
			<OtherFiles Include="$(OutputPath)\*;" Exclude="$(OutputPath)\$(AssemblyName).exe;$(OutputPath)\$(AssemblyName).exe.config;$(OutputPath)\$(AssemblyName).dll;$(OutputPath)\$(AssemblyName).dll.config;$(OutputPath)\OpenExeConfig.json;$(OutputPath)\$(AssemblyName).deps.json;$(OutputPath)\$(AssemblyName).runtimeconfig.json;$(OutputPath)\$(AssemblyName).runtimeconfig.dev.json;$(OutputPath)\方案\*;" />
		</ItemGroup>
		<Delete Files="@(OtherFiles)" />
		<RemoveDir Directories="$(OutputPath)\ca-ES\;$(OutputPath)\cs-CZ\;$(OutputPath)\cs-CZ\;$(OutputPath)\de\;$(OutputPath)\es\;$(OutputPath)\fr\;$(OutputPath)\hu\;$(OutputPath)\it\;$(OutputPath)\ja\;$(OutputPath)\ja\;$(OutputPath)\ko\;$(OutputPath)\nl-BE\;$(OutputPath)\pl\;$(OutputPath)\pt\;$(OutputPath)\ro\;$(OutputPath)\ru\;$(OutputPath)\sv\;$(OutputPath)\zh-Hant\;$(OutputPath)\tr\;$(OutputPath)\pt-BR\;$(OutputPath)\cs\;$(OutputPath)\zh-Hans\" />
	</Target>

	<Target Condition="'$(TargetFramework)' == 'net7.0-windows'" Name="DeleteOtherFileNet6" AfterTargets="AfterBuild">

