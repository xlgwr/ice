<Fluent:RibbonWindow  xmlns:Fluent="urn:fluent-ribbon" x:Class="Tools.OpenExe.MainRibbonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tools.OpenExe" xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:Forms ="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:my="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration" 
        xmlns:usercontrolcomm="clr-namespace:Tools.OpenExe.UserControlComm"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock" 
        xmlns:local1="clr-namespace:Tools.OpenExe.UserControlComm"
        mc:Ignorable="d"
        Title="一键启动多功能工具V8"
        Height="666"                     
        Width="920" MinHeight="300"
        ResizeMode="CanResize" x:Name="mainwindows" Topmost="True" UseLayoutRounding="True">
    <Grid x:Name="layoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Fluent:Ribbon Grid.Row="0" x:Name="ribbon"
                       AutomaticStateManagement="True"
                       CanUseSimplified="True">

            <!--Backstage-->
            <Fluent:Ribbon.Menu>
                <Grid>
                    <!-- Backstage items can be keytipped -->
                    <Fluent:Backstage x:Name="Backstage" Header="目录切换"
                                      Visibility="Visible" IsOpenChanged="Backstage_IsOpenChanged">
                        <Fluent:BackstageTabControl>

                            <Fluent:BackstageTabItem Header="目录切换"
                                                     Icon="{DynamicResource Fluent.Ribbon.Images.DefaultPlaceholder}"
                                                     KeyTip="T">
                                <StackPanel Orientation="Vertical">

                                    <Grid Margin="5">
                                        <Grid.ColumnDefinitions>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="35" />
                                            <RowDefinition Height="5" />
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Button x:Name="btnselectFileDataR" Content="新增目录" Margin="0" Width="140" Height="25" Click="btnselectFileDataR_Click" />
                                            <TextBox x:Name="txtfilePathData" Height="25" Margin="0" MinWidth="390" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" KeyDown="txtfilePathData_KeyDown"/>
                                        </StackPanel>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition></ColumnDefinition>
                                                <ColumnDefinition Width="120"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <DockPanel Grid.Column="0">
                                                <ListBox x:Name="allfileslstbox" DockPanel.Dock="Top" MouseDoubleClick="allfileslstbox_MouseDoubleClick" SelectionChanged="allfileslstbox_SelectionChanged">
                                                    <ListBox.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="设置目录" Click="btnSet_Click"/>
                                                            <MenuItem Header="删除目录" Click="btnDelete_Click"/>
                                                        </ContextMenu>
                                                    </ListBox.ContextMenu>
                                                </ListBox>
                                            </DockPanel>
                                            <StackPanel Grid.Column="1">
                                                <Button x:Name="btnAdd" Margin="5" Padding="5" Click="btnAdd_Click" >新增目录到列表</Button>
                                                <Button x:Name="btnSet" Margin="5" Padding="5" Click="btnSet_Click">设置当前选择目录</Button>
                                                <Button x:Name="btnDelete" Margin="5" Padding="5" Click="btnDelete_Click">删除当前选择目录</Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Fluent:BackstageTabItem>

                            <Fluent:SeparatorTabItem />

                            <Fluent:Button VerticalAlignment="Bottom"
                                           Click="Button_Close_Click"
                                           DockPanel.Dock="Bottom"
                                           Header="退出"
                                           Icon="{iconPacks:Material Kind=ExitToApp}"
                                           KeyTip="X" />
                        </Fluent:BackstageTabControl>
                    </Fluent:Backstage>
                </Grid>
            </Fluent:Ribbon.Menu>

            <Fluent:Ribbon.QuickAccessItems>
                <!-- Quick Access toolbar items automatically have ScreenTips of the target -->
                <!-- KeyTips in Quick Access Toolbar names automatically -->
                <Fluent:QuickAccessMenuItem IsChecked="true">
                    <Fluent:Button Header="置顶" x:Name="btntop" Click="btnIsTop_Click"
                                  ToolTip="置顶"  Icon="{iconPacks:Material Kind=FormatVerticalAlignTop}" LargeIcon="{iconPacks:Material Kind=FormatVerticalAlignTop}"/>
                    <!-- The following code shows theme colors mode for color gallery -->
                </Fluent:QuickAccessMenuItem>
            </Fluent:Ribbon.QuickAccessItems>

            <!--Tabs-->

            <Fluent:RibbonTabItem Header="文件" IsOpen="True" >
                <Fluent:RibbonGroupBox Header="方案" TabIndex="1">
                    <StackPanel Orientation="Vertical" Width="auto">
                        <Fluent:ComboBox Header="查找类型:" x:Name="GetNameExt" Text=".exe"  Margin="2,10,5,0" Width="190"  Height="25" IsEditable="True" SelectionChanged="GetName_SelectionChanged" >
                            <ListBoxItem Content=".exe"/>
                            <ListBoxItem Content=".dll"/>
                            <ListBoxItem Content=".log"/>
                            <ListBoxItem Content=".txt"/>
                            <ListBoxItem Content=".csv"/>
                            <ListBoxItem Content=".json"/>
                            <ListBoxItem Content=".bin"/>
                            <ListBoxItem Content=".dat"/>
                        </Fluent:ComboBox>
                        <Fluent:ComboBox Header="方案组别:" x:Name="projectList" Margin="2,10,5,0" Width="190" Height="25" IsEditable="False" SelectionChanged="projectList_SelectionChanged"/>
                    </StackPanel>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="操作功能" TabIndex="2">
                    <Fluent:Button Header="获取" ToolTip="获取当前目录文件" Margin="10,5,5,0" x:Name="btnLoadData"
                                Icon="{iconPacks:Material Kind=FolderSearch}" 
                                LargeIcon="{iconPacks:Material Kind=FolderSearch, Height=30, Width=30}" Foreground="Black" Click="btnLoadData_Click" />
                    <Fluent:Button Header="运行" x:Name="btnRunExe"  ToolTip="运行选择的Exe" Margin="10,5,5,0" Click="btnRunExe_Click"
                                Icon="{iconPacks:Material Kind=PlayCircle}" 
                                LargeIcon="{iconPacks:Material Kind=PlayCircle, Height=30, Width=30}" Foreground="Green" />
                    <Fluent:Button Header="关闭" x:Name="btnStopExe"  Click="btnStopExe_Click" ToolTip="关闭当前所有Exe" Margin="10,5,5,0"
                                Icon="{iconPacks:Material Kind=StopCircleOutline}" 
                                LargeIcon="{iconPacks:Material Kind=StopCircleOutline, Height=30, Width=30}" Foreground="Red" />
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="关闭操作" TabIndex="3">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="5" >
                        <CheckBox Content="关闭byName" ToolTip="用于多个相同程序时，可针对关闭，而非全部相同的exe名。" VerticalContentAlignment="Center" x:Name="ckCloseByName" IsChecked="False" Margin="2"></CheckBox>
                    </StackPanel>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="系统功能">
                    <my:WindowsFormsHost Margin="8,0,8,0" Height="26" Width="153" >
                        <Forms:DateTimePicker Format="Custom" ShowUpDown="True"  CustomFormat="yyyy-MM-dd HH:mm:ss" x:Name="selectDateTime"/>
                    </my:WindowsFormsHost>
                    <Button x:Name="btnSetTime"   Content="修改电脑时间"  HorizontalAlignment="Center"                          VerticalAlignment="Center" Height="26" Width="153" Click="btnSetTime_Click"/>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="功能扩展">
                    <Fluent:Button x:Name="btnShowSearch"   Header="搜索及ICE流解包" Margin="0,5,5,0"
                                Icon="{iconPacks:Material Kind=TextBoxSearchOutline}"  ToolTip="日志文件ICE流解包及文件搜索功能"
                                LargeIcon="{iconPacks:Material Kind=TextBoxSearchOutline, Height=30, Width=30}"  Click="btnShowSearch_Click"/>
                    <Fluent:Button x:Name="btnOpenDic"   Header="打开Local目录"
                                Icon="{iconPacks:Material Kind=MapMarkerPath}" 
                                LargeIcon="{iconPacks:Material Kind=MapMarkerPath, Height=30, Width=30}" 
                        Margin="0,5,5,0" ToolTip="C:\Users\%USERNAME%\AppData\Local\Yintech,修改本地config设置"
                      Click="btnOpenDic_Click" />
                    <Fluent:Button x:Name="btnTest"   Header="Test" Margin="0,5,5,0"
                                Icon="{iconPacks:Material Kind=TextBoxSearchOutline}" 
                                LargeIcon="{iconPacks:Material Kind=TextBoxSearchOutline, Height=30, Width=30}"  Visibility="Collapsed" Click="btnTest_Click"/>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
            <Fluent:RibbonTabItem Header="服务端-ICE通讯">
                <Fluent:RibbonGroupBox Header="服务端" TabIndex="1">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="5" >
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0" >
                            <Label Content="IP地址" HorizontalAlignment="Left" VerticalAlignment="Center" Width="54" />
                            <TextBox x:Name="txtServerIP" HorizontalAlignment="Left" TextWrapping="Wrap" Text="0.0.0.0" VerticalAlignment="Center" MinWidth="106" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0" >
                            <Label Content="端   口" HorizontalAlignment="Left" VerticalAlignment="Top" Width="54" />
                            <TextBox x:Name="txtServerPort" HorizontalAlignment="Left" TextWrapping="Wrap" Text="10089"  VerticalAlignment="Center"	MinWidth="106" />
                        </StackPanel>
                    </StackPanel>
                    <Fluent:Button Header="启动" ToolTip="启动当前服务" Margin="10,5,5,0" x:Name="btnServerRun"
                                Icon="{iconPacks:Material Kind=PlayCircle}" 
                                LargeIcon="{iconPacks:Material Kind=PlayCircle, Height=30, Width=30}" Foreground="Green" Click="btnServerRun_Click" />
                    <Fluent:Button Header="断开" ToolTip="断开当前连接" Margin="10,5,5,0" x:Name="btnServerStop"  Click="btnServerStop_Click"
                                Icon="{iconPacks:Material Kind=StopCircleOutline}" 
                                LargeIcon="{iconPacks:Material Kind=StopCircleOutline, Height=30, Width=30}" Foreground="Red" />

                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="推送客户端操作" TabIndex="2">

                    <Fluent:Button Header="推送" ToolTip="推送客户端信息,根据客户端Type" Margin="5,5,5,0" x:Name="btnServerPush"
                                Icon="{iconPacks:Material Kind=Target}" 
                                LargeIcon="{iconPacks:Material Kind=Target, Height=30, Width=30}" Foreground="Green" Click="btnServerPush_Click" />

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,5,5,5" >
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-4,0,0" >
                            <Label Content="ClientType" HorizontalContentAlignment="Right"  VerticalAlignment="Top" MinWidth="68" />
                            <TextBox x:Name="txtPushType" ToolTip="ClientType 客户端类型" HorizontalAlignment="Left" TextWrapping="Wrap" Text="1"  VerticalAlignment="Center"	MinWidth="50" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-4,0,0" >
                            <Label Content="AcmTime" HorizontalContentAlignment="Right"  VerticalAlignment="Top" MinWidth="68" />
                            <TextBox x:Name="txtAcmTimeServer" ToolTip="服务端,心跳时间" HorizontalAlignment="Left" TextWrapping="Wrap" Text="60"  VerticalAlignment="Center"	MinWidth="50" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-5,0,0" >
                            <Label Content="推送数" ToolTip="批量发送数，总发送数" HorizontalContentAlignment="Right"  VerticalAlignment="Top" MinWidth="68" />
                            <TextBox x:Name="txtServerNumber" HorizontalAlignment="Left" TextWrapping="Wrap" Text="1"  VerticalAlignment="Center"	MinWidth="50" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-5,0,0" >
                            <Label Content="合包数" ToolTip="每次发送合包数，单个包，消息数"  HorizontalContentAlignment="Right"   VerticalAlignment="Top" MinWidth="68"/>
                            <TextBox x:Name="txtDataSize" HorizontalAlignment="Left"  TextWrapping="Wrap" Text="1" VerticalAlignment="Center" MinWidth="50"/>
                        </StackPanel>
                    </StackPanel>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="条件设置" TabIndex="3">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="5" >
                        <CheckBox Content="是否显示信息内容" ToolTip="是否显示信息内容" VerticalContentAlignment="Center" x:Name="isShowMsg" IsChecked="False" Margin="0,0,0,0" Click="isShowMsg_Click"></CheckBox>
                        <CheckBox Content="是否异步推送合包" ToolTip="是否异步推送合包" VerticalContentAlignment="Center" x:Name="isPushAsync" IsChecked="False" Margin="0,0,0,0" Click="isPushAsync_Click"></CheckBox>
                        <CheckBox Content="是否初始化计数" ToolTip="合包主键计数" VerticalContentAlignment="Center" x:Name="isInitNumServer" IsChecked="False" Margin="0,0,0,0"></CheckBox>
                        <CheckBox x:Name="ckIsICEStreamToPush" Content="使用ICEStream" ToolTip="消息类型：MType为1 才支持流功能,0:old 消息类,1:批量类,2:内存 通用,3:内存 交易"  Margin="0,0,0,0" VerticalContentAlignment="Center"/>

                    </StackPanel>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="其它参数设置" TabIndex="4">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="5" >
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0" >
                            <Label Content="主备ID" ToolTip="内存服务器"  HorizontalContentAlignment="Right" VerticalContentAlignment="Center" VerticalAlignment="Center" MinWidth="85" />
                            <TextBox x:Name="txtActiveAndsandby" HorizontalAlignment="Left" TextWrapping="Wrap" Text="C1,C2"  VerticalAlignment="Center"	MinWidth="106" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0" >
                            <Label Content="主备交易用ID" ToolTip="交易服务器" HorizontalAlignment="Left" VerticalAlignment="Top" Width="85" />
                            <TextBox x:Name="txtTradeActiveAndsandby" HorizontalAlignment="Left" TextWrapping="Wrap" Text="T1,T2"  VerticalAlignment="Center"	MinWidth="106" />
                        </StackPanel>
                    </StackPanel>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="默认布局">
                    <Fluent:Button Header="ICEServer布局" ToolTip="ICEServer布局" Margin="10,5,5,0" 
                                Icon="{iconPacks:Material Kind=PageLayoutHeaderFooter}" 
                                LargeIcon="{iconPacks:Material Kind=PageLayoutHeaderFooter, Height=30, Width=30}" Foreground="Blue" Click="Button_ConfigLoad_Click" />

                    <Fluent:Button Header="ICEServerAndClient布局" ToolTip="ICEServerAndClient布局" Margin="10,5,5,0" 
                                Icon="{iconPacks:Material Kind=PageLayoutHeaderFooter}" 
                                LargeIcon="{iconPacks:Material Kind=PageLayoutHeaderFooter, Height=30, Width=30}" Foreground="Black" Click="Button_ConfigLoad_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
            <Fluent:RibbonTabItem Header="客户端-ICE通讯" >
                <Fluent:RibbonGroupBox Header="连接服务端" TabIndex="1">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,5,0,0" >
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0" >
                            <Label Content="IP地址" HorizontalAlignment="Left" VerticalAlignment="Center" Width="54" />
                            <TextBox x:Name="txtClientIP" HorizontalAlignment="Left" TextWrapping="Wrap" Text="127.0.0.1" VerticalAlignment="Center" MinWidth="90" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0" >
                            <Label Content="端   口" HorizontalAlignment="Left" VerticalAlignment="Top" Width="54" />
                            <TextBox x:Name="txtClientPort" HorizontalAlignment="Left" TextWrapping="Wrap" Text="10089"  VerticalAlignment="Center"	MinWidth="90" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,5,0,0" >
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0" >
                            <Label Content="ClientID"  HorizontalContentAlignment="Right" VerticalAlignment="Center" Width="70" />
                            <TextBox x:Name="txtClientId" HorizontalAlignment="Left" TextWrapping="Wrap" Text="7777" VerticalAlignment="Center" MinWidth="50" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0" >
                            <Label Content="ClientType" HorizontalAlignment="Left" VerticalAlignment="Top" Width="70" />
                            <TextBox x:Name="txtClientType" HorizontalAlignment="Left" TextWrapping="Wrap" Text="3"  VerticalAlignment="Center"	MinWidth="50" />
                        </StackPanel>
                    </StackPanel>
                    <Fluent:Button Header="连接" ToolTip="连接服务端IP" Margin="8,5,5,0" x:Name="btnClientRun"
                                Icon="{iconPacks:Material Kind=PlayCircle}" 
                                LargeIcon="{iconPacks:Material Kind=PlayCircle, Height=30, Width=30}" Foreground="Green" Click="btnClientRun_Click" />
                    <Fluent:Button Header="断开" ToolTip="断开当前连接" Margin="5,5,5,0" x:Name="btnClientStop"  Click="btnClientStop_Click"
                                Icon="{iconPacks:Material Kind=StopCircleOutline}" 
                                LargeIcon="{iconPacks:Material Kind=StopCircleOutline, Height=30, Width=30}" Foreground="Red" />

                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="操作" TabIndex="2">
                    <Fluent:Button Header="发送" ToolTip="发送数据到服务端" Margin="3,5,5,0" x:Name="btnSendClient"
                                Icon="{iconPacks:Material Kind=Target}" 
                                LargeIcon="{iconPacks:Material Kind=Target, Height=30, Width=30}" Foreground="Green" Click="btnSendClient_Click" />
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="0,5,0,0" >
                        <CheckBox x:Name="ckIsAsync" IsChecked="False" Margin="1"  Content="是否异步"  />
                        <CheckBox x:Name="ckAddOne" IsChecked="False"  Margin="1"   Content="是否加1" ToolTip="服务号是否加1"/>
                        <CheckBox x:Name="ckAddKey" IsChecked="False"  Margin="1"   Content="是否增量" ToolTip="委托号，成交号，持仓号是否加1"/>
                        <CheckBox x:Name="ckAutoSend" IsChecked="False"  Margin="1"   Content="定时发送" ToolTip="定时触发，发送功能。" Click="ckAutoSend_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="0,5,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-4,0,0" >
                            <Label Content="发送数" ToolTip="批量发送数，总发送数" HorizontalAlignment="Left" VerticalAlignment="Top"  />
                            <TextBox x:Name="txtNumber" HorizontalAlignment="Left" TextWrapping="Wrap" Text="1"  VerticalAlignment="Center"	MinWidth="50" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-5,0,0" >
                            <Label Content="合包数" ToolTip="每次发送合包数，单个包，消息数" HorizontalAlignment="Left"   VerticalAlignment="Top"  />
                            <TextBox x:Name="txtNumberSend" HorizontalAlignment="Left"  TextWrapping="Wrap" Text="1" VerticalAlignment="Center" MinWidth="50"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-5,0,0" >
                            <Label Content="ACMTime" ToolTip="心跳时间" HorizontalAlignment="Left"   VerticalAlignment="Top"  />
                            <TextBox x:Name="txtAcmTime" HorizontalAlignment="Left"  TextWrapping="Wrap" Text="60" VerticalAlignment="Center" MinWidth="50"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-5,0,0" >
                            <Label Content="定时间" ToolTip="每次发送间隔时间（s)" HorizontalAlignment="Left"   VerticalAlignment="Top"  />
                            <TextBox x:Name="txtTimeAutoSend" HorizontalAlignment="Left"  TextWrapping="Wrap" Text="3" VerticalAlignment="Center" MinWidth="50"/>
                        </StackPanel>
                        <!--<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-5,0,0" >
                            <Label Content="发送间隔s" ToolTip="" HorizontalAlignment="Left"   VerticalAlignment="Top"/>
                            <TextBox x:Name="txtSendTime" HorizontalAlignment="Left"  TextWrapping="Wrap" Text="1" VerticalAlignment="Center" MinWidth="50"/>
                        </StackPanel>-->
                        <!--<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-7,0,0" >
                            <Label Content="单包大小M" HorizontalAlignment="Left"   VerticalAlignment="Top"/>
                            <TextBox x:Name="txtSendSize" HorizontalAlignment="Left"  TextWrapping="Wrap" Text="1" VerticalAlignment="Center" MinWidth="50"/>
                        </StackPanel>-->
                    </StackPanel>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="条件设置" TabIndex="3">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="0,5,0,0" >
                        <CheckBox x:Name="isClientShowMsg" Content="显示收到信息" IsChecked="False"  HorizontalAlignment="Left" VerticalAlignment="Center" Click="isClientShowMsg_Click"></CheckBox>
                        <CheckBox x:Name="ckZip" Content="ICE zip压缩"  HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <CheckBox x:Name="ckInitAddNum" Content="初始化批量计数"  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ckIsICEStreamToSend" Content="使用ICEStream" ToolTip="消息类型：MType为1,3才支持流功能,0:old 消息类,1:批量类,2:内存 通用,3:内存 交易"   HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="2,5,0,0" >
                        <CheckBox x:Name="ckIsListCacheTrade" Content="CacheDB是否合包"  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ckOnewey" Content="twoWay"  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ckIsLogTest" Content="Log批量测试"  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ckIsSaveStream" Content="保存ICEStream" ToolTip="保存log文件streamlog.bin" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="3,5,0,0" >
                        <CheckBox x:Name="ckSizeTest" Content="单包大小测试" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="databody大小发包" />
                        <TextBlock>过滤服务号：</TextBlock>
                        <TextBox x:Name="txtFilterServerNo" ToolTip="收到回报不显示对应内容，只显示长度。">920003,921001</TextBox>
                    </StackPanel>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="其它设置">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0" >
                        <CheckBox x:Name="ckAddSendTime" IsChecked="False"  Margin="1"   Content="带上发送时间" ToolTip="发送包Head加上发送时间" Click="ckAddSendTime_Click"/>
                    </StackPanel>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="默认布局">
                    <Fluent:Button Header="ICEClient布局" ToolTip="ICEClient布局" Margin="10,5,5,0" 
                                Icon="{iconPacks:Material Kind=PageLayoutHeader}" 
                                LargeIcon="{iconPacks:Material Kind=PageLayoutHeader, Height=30, Width=30}" Foreground="DarkOliveGreen" Click="Button_ConfigLoad_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
            <Fluent:RibbonTabItem Header="窗口">
                <Fluent:RibbonGroupBox Header="布局管理">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5" >
                        <Fluent:Button Header="保存当前布局" ToolTip="保存当前布局" Margin="10,5,5,0" x:Name="btnSaveLayout"
                                Icon="{iconPacks:Material Kind=PageLayoutBody}" 
                                LargeIcon="{iconPacks:Material Kind=PageLayoutBody, Height=30, Width=30}" Foreground="Green" Click="btnSaveLayout_Click" />
                        <Fluent:ComboBox Header="布局列表:"  MinWidth="190" x:Name="layoutComb" IsEditable="False" SelectionChanged="layoutComb_SelectionChanged"></Fluent:ComboBox>

                    </StackPanel>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="默认布局">
                    <Fluent:Button Header="ICEServer布局" ToolTip="ICEServer布局" Margin="10,5,5,0" 
                                Icon="{iconPacks:Material Kind=PageLayoutHeaderFooter}" 
                                LargeIcon="{iconPacks:Material Kind=PageLayoutHeaderFooter, Height=30, Width=30}" Foreground="Blue" Click="Button_ConfigLoad_Click" />

                    <Fluent:Button Header="ICEClient布局" ToolTip="ICEClient布局" Margin="10,5,5,0" 
                                Icon="{iconPacks:Material Kind=PageLayoutHeader}" 
                                LargeIcon="{iconPacks:Material Kind=PageLayoutHeader, Height=30, Width=30}" Foreground="DarkOliveGreen" Click="Button_ConfigLoad_Click" />

                    <Fluent:Button Header="ICEServerAndClient布局" ToolTip="ICEServerAndClient布局" Margin="10,5,5,0" 
                                Icon="{iconPacks:Material Kind=PageLayoutHeaderFooter}" 
                                LargeIcon="{iconPacks:Material Kind=PageLayoutHeaderFooter, Height=30, Width=30}" Foreground="Black" Click="Button_ConfigLoad_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
            <Fluent:RibbonTabItem Header="设置" >
                <Fluent:RibbonGroupBox Header="参数设置">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" >
                        <TextBlock Margin="0">删除log目录:</TextBlock>
                        <TextBox x:Name="txtlogPath" Margin="1" Width="185" TextWrapping="Wrap" Height="48" VerticalScrollBarVisibility="Auto" >log,CSVLog,csv,tmp</TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Margin="0">文件名过滤:</TextBlock>
                        <TextBox x:Name="filterName" Text="updater,upgrade,other" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="1" Width="185" Height="48">
                        </TextBox>
                    </StackPanel>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="系统设置">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="5" >
                        <CheckBox Content="退出时自动最小化" ToolTip="退出时自动最小化，可在右下角任务栏中可查看" VerticalContentAlignment="Center" x:Name="ckCloseToHide" IsChecked="False" Margin="2"></CheckBox>
                        <CheckBox Content="重复打开是否提示" ToolTip="重复打开是否提示" VerticalContentAlignment="Center" x:Name="ckReOpenNotice" IsChecked="False" Margin="2"></CheckBox>
                    </StackPanel>

                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="操作">
                    <Fluent:Button Header="保存设置" x:Name="btnSaveConfig"  ToolTip="保存设置" Margin="10,5,5,0" Click="btnSaveConfig_Click"
                                Icon="{iconPacks:Material Kind=ContentSaveCog}" 
                                LargeIcon="{iconPacks:Material Kind=ContentSaveCog, Height=30, Width=30}" Foreground="Green" />

                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

        </Fluent:Ribbon>

        <DockingManager x:Name="dockManager"
            Grid.Row="1"
            AllowMixedOrientation="True"
            AutoWindowSizeWhenOpened="True"
            DocumentClosing="DockManager_DocumentClosing"
            IsVirtualizingAnchorable="True"
            IsVirtualizingDocument="True">
            <DockingManager.Theme>
                <Vs2013LightTheme />
            </DockingManager.Theme>
            <DockingManager.DocumentHeaderTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Margin="0,0,0,0" Source="{Binding IconSource}" />
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </DockingManager.DocumentHeaderTemplate>
            <LayoutRoot PropertyChanged="OnLayoutRootPropertyChanged">
                <LayoutPanel Orientation="Horizontal">
                    <LayoutDocumentPaneGroup>
                        <LayoutDocumentPane x:Name="LayoutDocumentPane">
                            <LayoutDocument CanClose="False"
                                Title="文件列表"
                                ContentId="document1">
                                <DockPanel Margin="0">
                                    <ToolBar DockPanel.Dock="Top">
                                        <Fluent:CheckBox x:Name="cbAll" Header="选择" VerticalContentAlignment="Center"  ToolTip="全选"  SizeDefinition="Middle" Click="CheckBox_Checked" IsChecked="True" />
                                        <Fluent:CheckBox Header="显示删除log" ToolTip="显示第一个选择框" VerticalContentAlignment="Center" x:Name="ckIsShowRemoveLog" Click="ckIsHowRemoveLog_Click"></Fluent:CheckBox>
                                        <Fluent:CheckBox Header="删除log目录" VerticalContentAlignment="Center" x:Name="ckRemoveLog" Click="ckRemoveLog_Click" ></Fluent:CheckBox>
                                        <Fluent:Button x:Name="sortBySelect" 
                                       SizeDefinition="Middle,Middle,Small" Header="排序by选择"
                                       Icon="{iconPacks:Material Kind=SortBoolAscendingVariant}" 
                                       LargeIcon="{iconPacks:Material Kind=SortBoolAscendingVariant, Height=30, Width=30}"
                                       Background="Transparent" BorderThickness="0" Margin="2,0,0,0" Click="sortBySelect_Click" />
                                        <Fluent:Button x:Name="openSelectFload" 
                                       SizeDefinition="Middle,Middle,Small" Header="打开文件目录"
                                       Icon="{iconPacks:Material Kind=FolderOpen}" 
                                       LargeIcon="{iconPacks:Material Kind=FolderOpen, Height=30, Width=30}"
                                       Background="Transparent" BorderThickness="0" Margin="2,0,0,0" Click="openSelectFload_Click" />
                                        <Fluent:TextBox Header="过滤:" Name="SearchFilter" MinWidth="105" TextChanged="SearchFilter_TextChanged" TextAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                        <Separator/>
                                        <Fluent:Button x:Name="addCustomerFile" Click="addCustomerFile_Click" 
                                       SizeDefinition="Middle,Middle,Small" 
                                       Icon="{iconPacks:Material Kind=NotePlusOutline}" 
                                       LargeIcon="{iconPacks:Material Kind=NotePlusOutline, Height=30, Width=30}"
                                       Header="添加文件" ToolTip="用于临时添加文件，生成MD5校验"/>
                                    </ToolBar>
                                    <Grid Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="leftCol" MinWidth="100" Width="3*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <ListBox Grid.Row="0" Grid.Column="0" Margin="0" x:Name="allLst" BorderThickness="0"
                  ScrollViewer.VerticalScrollBarVisibility="Visible" MouseDoubleClick="allLst_MouseDoubleClick" >
                                            <ListBox.ContextMenu>
                                                <ContextMenu Name="menulist">
                                                    <MenuItem Header="运行" Click="MenuItem_Click_2"/>
                                                    <MenuItem Header="重启" Click="MenuItem_Click_23"/>
                                                    <MenuItem Header="关闭" Click="MenuItem_Click_3"/>
                                                    <MenuItem Header="关闭并删除log" Click="MenuItem_Click_6"/>
                                                    <MenuItem Header="打开文件目录" Click="MenuItem_Click"/>
                                                    <MenuItem Header="添加到过滤" Click="MenuItem_Click_1"/>
                                                    <MenuItem Header="保存当前方案" Click="MenuItem_Click_4"/>
                                                    <MenuItem Header="选择方案" Click="MenuItem_Click_5"/>
                                                    <MenuItem Header="生成MD5版本校验" Click="MenuItem_Click_md5" ToolTip="选择项生成,由测试人员生成，测试环境，非发版目录"/>
                                                    <MenuItem Header="校验选择版本及MD5" ToolTip="校验,exe及应用目录下dll" Click="MenuItem_Click_md5_check"/>
                                                    <MenuItem Header="复制到另一目录" Click="MenuItem_Click_Copyto" ToolTip="当前目录下文件，全部复制到另一目录。"/>
                                                    <MenuItem Header="复制到另一目录【新选项卡】" Click="MenuItem_Click_Copyto_new" ToolTip="当前目录下文件，全部复制到另一目录【新选项卡】"/>
                                                    <MenuItem Header="置顶切换" Click="MenuItem_Click_top"/>
                                                </ContextMenu>
                                            </ListBox.ContextMenu>

                                            <ListBoxItem Background="LightCoral" Foreground="Red"
             FontFamily="Verdana" FontSize="12" FontWeight="Bold">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="33">
                                                    <CheckBox ToolTip="DelFlag"/>
                                                    <CheckBox>
                                                        <TextBlock Text="Coffie" VerticalAlignment="Center"></TextBlock>
                                                    </CheckBox>
                                                    <TextBlock Margin="5,0,0,0" Foreground="#FF613636">00</TextBlock>
                                                </StackPanel>
                                            </ListBoxItem>
                                        </ListBox>
                                    </Grid>
                                </DockPanel>
                            </LayoutDocument>
                            <LayoutDocument Title="目录复制"
                                ContentId="document2" CanClose="False">
                                <usercontrolcomm:CopyTo_UC x:Name="copytoWin"/>
                            </LayoutDocument>
                            <!--<LayoutDocument Title="ICE Server 收到消息" ContentId="AutoHide2LogIceServer" CanClose="True">                               
                                    <local1:AvalonEditUserControl x:Name="logShowIceServer"></local1:AvalonEditUserControl>                               
                            </LayoutDocument>-->
                        </LayoutDocumentPane>
                    </LayoutDocumentPaneGroup>
                </LayoutPanel>

                <LayoutRoot.RightSide>
                    <LayoutAnchorSide>
                        <LayoutAnchorGroup>
                            <LayoutAnchorable Title="文本内容搜索及ICE文件流解包" ContentId="AutoHide2Content" CanClose="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition MinWidth="100" Width="auto"></ColumnDefinition>
                                        <ColumnDefinition Width="0.01*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                                        <StackPanel>
                                            <Fluent:Button x:Name="ckLogSearch" Click="ckLogSearch_Click"  Margin="2" Height="25"  Header="文本内容搜索"   Icon="{iconPacks:Material Kind=TextBoxSearchOutline}" 
                                LargeIcon="{iconPacks:Material Kind=TextBoxSearchOutline, Height=30, Width=30}"  SizeDefinition="Middle,Middle,Small" ToolTip="查询文本文件内容功能"/>
                                            <Fluent:Button x:Name="fixLogSearch" Click="fixLogSearch_Click"  Margin="2" Height="25"  Header="Fix内容统计"   Icon="{iconPacks:Material Kind=AutoFix}" 
                                LargeIcon="{iconPacks:Material Kind=AutoFix, Height=30, Width=30}"  SizeDefinition="Middle,Middle,Small" ToolTip="统计fix日志tag功能"/>
                                            <Fluent:Button x:Name="iceBinPackage" Click="iceBinPackage_Click"  Margin="2" Height="25"  Header="ICE流解包"   Icon="{iconPacks:Material Kind=PackageUp}" 
                                LargeIcon="{iconPacks:Material Kind=PackageUp, Height=30, Width=30}"  SizeDefinition="Middle,Middle,Small" ToolTip="日志文件ICE流解包"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <DockPanel  Grid.Row="0" Grid.Column="1" >
                                        <GroupBox Header="行搜索条件" DockPanel.Dock="Top">
                                            <Grid>
                                                <Grid.ColumnDefinitions></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition></RowDefinition>
                                                    <RowDefinition></RowDefinition>
                                                    <RowDefinition></RowDefinition>
                                                </Grid.RowDefinitions>
                                                <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <StackPanel Orientation="Vertical"   HorizontalAlignment="Left" >
                                                            <RadioButton GroupName="rbFlag" IsChecked="True" Margin="0,15,0,0" Width="55">包含</RadioButton>
                                                            <!--<RadioButton GroupName="rbFlag">不包含</RadioButton>-->
                                                        </StackPanel>
                                                        <TextBox x:Name="txtFilter" Text="" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="5,0,0,0" MinWidth="300" ToolTip="多个分号或逗号隔开，如：123;abc;ddd" Height="48">
                                                        </TextBox>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="5">
                                                        <RadioButton GroupName="rbFlagOrAnd" IsChecked="True">并且</RadioButton>
                                                        <!--<RadioButton GroupName="rbFlagOrAnd"  Margin="20,0,0,0">或</RadioButton>-->
                                                        <Label HorizontalContentAlignment="Center" HorizontalAlignment="Center" Padding="0" Margin="10,0,0,0">过滤符合行条数：</Label>
                                                        <TextBox x:Name="txtTopCount" Width="90">1000</TextBox>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <StackPanel Orientation="Vertical"   HorizontalAlignment="Center" >
                                                            <!--<RadioButton GroupName="rbFlag2" >包含</RadioButton>-->
                                                            <RadioButton GroupName="rbFlag2" IsChecked="True" Margin="0,15,0,0" Width="55">不包含</RadioButton>
                                                        </StackPanel>
                                                        <TextBox x:Name="txtFilterNo" Text="" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="5,0,0,0" MinWidth="300" ToolTip="多个分号或逗号隔开，如：123;abc;ddd，显示内容：aa|cc" Height="48">
                                                        </TextBox>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Visibility="Collapsed" HorizontalAlignment="Left" Margin="5">
                                                        <TextBlock Margin="5">TT FIX URL:</TextBlock>
                                                        <TextBox Margin="5"  x:Name="txtfixurl" MinWidth="500" Height="20">https://library.tradingtechnologies.com/tt-fix/uat/TT-FIX42.xml</TextBox>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </GroupBox>
                                        <local1:AvalonEditUserControl x:Name="logShow"></local1:AvalonEditUserControl>
                                    </DockPanel>
                                </Grid>
                            </LayoutAnchorable>
                        </LayoutAnchorGroup>

                    </LayoutAnchorSide>
                </LayoutRoot.RightSide>
            </LayoutRoot>
        </DockingManager>
        <Fluent:StatusBar Grid.Row="2" Margin="0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Bottom"
                          Visibility="Visible" Background="Transparent">

            <Fluent:StatusBarItem Title="提示" 
                                   HorizontalAlignment="Left"
                                   Value="16"
                                   ToolTip="提示" >
                <Label x:Name="lblmsg" Content="提示" FontWeight="Bold" Foreground="Red"/>
            </Fluent:StatusBarItem>

            <Separator HorizontalAlignment="Left" />
            <Fluent:StatusBarItem Title="Used memory"
                                  HorizontalAlignment="Right"
                                  Value="{Binding UsedMemory, StringFormat={}{0:##\,000} KB}" />

            <Separator HorizontalAlignment="Right" />

            <Fluent:StatusBarItem Title="Zoom"
                                  HorizontalAlignment="Right"
                                  Value="{Binding Value, ElementName=zoomSlider, StringFormat={}{0:P}}" />

            <Fluent:StatusBarItem Title="Test (no content, no value)"
                                  HorizontalAlignment="Right" />

            <Fluent:StatusBarItem Title="Zoom Slider"
                                  HorizontalAlignment="Right" Visibility="Collapsed">
                <Slider x:Name="zoomSlider"
                        IsDirectionReversed="False"
                        IsSnapToTickEnabled="True"
                        LargeChange="0.1"
                        Maximum="2.0"
                        Minimum="0.5"
                        SmallChange="0.1"
                        Style="{DynamicResource ZoomSliderStyle}"
                        TickFrequency="0.1"
                        ValueChanged="ZoomSlider_OnValueChanged"
                        Value="{Binding Zoom}" />
            </Fluent:StatusBarItem>
            <Fluent:StatusBarItem Title="version"
                                  HorizontalAlignment="Right">
                <Label x:Name="lblVersion"></Label>
            </Fluent:StatusBarItem>
        </Fluent:StatusBar>
    </Grid>
</Fluent:RibbonWindow>
