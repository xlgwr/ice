<Page x:Class="Tools.OpenExe.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Tools.OpenExe"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SettingPage">

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="5" />
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Button x:Name="btnselectFileDataR" Content="新增目录" Margin="0" Width="140" Height="25" Click="btnselectFileDataR_Click" />
            <TextBox x:Name="txtfilePathData" Height="25" Margin="0" MinWidth="390" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" KeyDown="txtfilePathData_KeyDown"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition Width="120"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <ListBox x:Name="allfileslstbox" DockPanel.Dock="Top" MouseDoubleClick="allfileslstbox_MouseDoubleClick" SelectionChanged="allfileslstbox_SelectionChanged">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="设置目录" Click="btnSet_Click"/>
                            <MenuItem Header="删除目录" Click="btnDelete_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
            <StackPanel Grid.Column="1">
                <Button x:Name="btnAdd" Margin="5" Padding="5" Click="btnAdd_Click" >新增目录到列表</Button>
                <Button x:Name="btnSet" Margin="5" Padding="5" Click="btnSet_Click">设置当前选择目录</Button>
                <Button x:Name="btnDelete" Margin="5" Padding="5" Click="btnDelete_Click">删除当前选择目录</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
