<Window x:Class="Test.PackageServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Test.PackageServer"
        mc:Ignorable="d"
        Title="ICE服务端Demo"
		Height="650"
		Width="1024">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Label Content="服务IP"
			   HorizontalAlignment="Left"
			   Margin="7,8,0,0"
			   VerticalAlignment="Top"
			   Width="54" />
        <TextBox x:Name="txtIP"
				 HorizontalAlignment="Left"
				 Margin="49,13,0,0"
				 TextWrapping="Wrap"
				 Text="0.0.0.0"
				 VerticalAlignment="Top"
				 Width="106" />
        <Label Content="端口"
			   HorizontalAlignment="Left"
			   Margin="7,39,0,0"
			   VerticalAlignment="Top"
			   Width="54" />
        <TextBox x:Name="txtPort"
				 HorizontalAlignment="Left"
				 Margin="49,44,0,0"
				 TextWrapping="Wrap"
				 Text="15001"
				 VerticalAlignment="Top"
				 Width="106" />
        <Button x:Name="btnConnect"
				Content="启动"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				Width="50"
				Margin="163,15,0,0"
				Height="50"
				Click="Button_Click" />
        <Button x:Name="btnDisconnect"
				Content="断开"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				Width="44"
				Margin="216,15,0,0"
				Height="50"
				Click="Button_Click_1" />
        <GroupBox x:Name="gb1"
				  Header="推送信息"
				  HorizontalAlignment="Left"
				  Height="340"
				  Margin="0,69,0,0"
				  VerticalAlignment="Top"
				  Width="470">
            <RichTextBox x:Name="rtRecPush"
						 HorizontalAlignment="Left"
						 Height="316"
						 VerticalAlignment="Top"
						 Width="450"
						 Margin="0,0,-2,0"
						 HorizontalScrollBarVisibility="Auto"
						 VerticalScrollBarVisibility="Auto"
						 ScrollViewer.CanContentScroll="True"
						 RenderTransformOrigin="0.5,0.5">
                <FlowDocument>
                    <Paragraph>
                        <Run Text="RichTextBox" />
                    </Paragraph>
                </FlowDocument>
            </RichTextBox>

        </GroupBox>
        <GroupBox x:Name="gb2"
				  Header="收到信息"
				  HorizontalAlignment="Left"
				  Height="340"
				  Margin="451,69,0,0"
				  VerticalAlignment="Top"
				  Width="528">
            <RichTextBox x:Name="rtRec"
						 HorizontalAlignment="Left"
						 Height="316"
						 VerticalAlignment="Top"
						 Width="517"
						 Margin="0,0,-1,0"
						 HorizontalScrollBarVisibility="Auto"
						 VerticalScrollBarVisibility="Auto"
						 ScrollViewer.CanContentScroll="True"
						 RenderTransformOrigin="0.5,0.5">
                <FlowDocument>
                    <Paragraph>
                        <Run Text="RichTextBox" />
                    </Paragraph>
                </FlowDocument>
            </RichTextBox>

        </GroupBox>
        <Button x:Name="btnClear"
				Content="清空"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				Width="51"
				Margin="672,15,0,0"
				Height="50"
				Click="btnClear_Click" />
        <Button x:Name="btnSendPush"
				Content="推送(旧)"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				Width="53"
				Margin="502,15,0,0"
				Height="50"
				Click="btnSendPush_Click" />
        <Button x:Name="btnSendPush_Stop"
				Content="停止推送"
                  FontSize="12"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				Width="55"
				Margin="615,15,0,0"
				Height="50"
				Click="btnSendPush_Stop_Click" />
        <Label Content="推送频率ms"
			   HorizontalAlignment="Left"
			   Margin="316,16,0,0"
			   VerticalAlignment="Top"
			   Width="78" />
        <TextBox x:Name="txtPushTime"
				 HorizontalAlignment="Left"
				 Margin="321,44,0,0"
				 TextWrapping="Wrap"
				 Text="1000"
				 VerticalAlignment="Top"
				 Width="62" />
        <Label Content="客户Type"
			   HorizontalAlignment="Left"
			   Margin="262,15,0,0"
			   VerticalAlignment="Top"
			   Width="61" />
        <TextBox x:Name="txtPushType"
				 HorizontalAlignment="Left"
				 Margin="264,44,0,0"
				 TextWrapping="Wrap"
				 Text="1" ToolTip="1,2,3"
				 VerticalAlignment="Top"
				 Width="52" />
        <Label Content="合包数"
			   HorizontalAlignment="Left"
			   Margin="388,16,0,0"
			   VerticalAlignment="Top"
			   Width="54" />
        <TextBox x:Name="DataSize"
				 HorizontalAlignment="Left"
				 Margin="388,44,0,0"
				 TextWrapping="Wrap"
				 Text="3"
				 VerticalAlignment="Top"
				 Width="47" />
        <Button x:Name="btnSendPush_CopyList"
            Content="推送(合包)"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Width="56"
            Margin="557,15,0,0"
            Height="50"
            Click="btnSendPush_CopyList_Click" />
        <CheckBox x:Name="isShowMsg" Content="是否显示信息内容" Margin="734,15,0,0" Height="25" Width="120" HorizontalAlignment="Left" VerticalAlignment="Top" Click="isShowMsg_Click"></CheckBox>
        <CheckBox x:Name="isPushAsync" Content="是否异步推送合包" Margin="734,33,0,0" Height="25" Width="120" HorizontalAlignment="Left" VerticalAlignment="Top" Click="isPushAsync_Click"/>
        <CheckBox x:Name="isPushOver" Content="是否转推送合包" Margin="734,53,0,0" Height="25" Width="120" HorizontalAlignment="Left" VerticalAlignment="Top" Click="isPushOver_Click"/>
        <Label Content="路由IP"
            HorizontalAlignment="Left"
            Margin="864,25,0,0"
            VerticalAlignment="Top" Visibility="Hidden"
            Width="44" />
        <TextBox x:Name="txtRoute_IP"
            HorizontalAlignment="Left"
            Margin="911,30,0,0"
            TextWrapping="Wrap"
            Text="127.0.0.1"
            VerticalAlignment="Top" Visibility="Hidden"
            Width="95" />
        <Label Content="端口"
            HorizontalAlignment="Left"
            Margin="874,47,0,0"
            VerticalAlignment="Top" Visibility="Hidden"
            Width="34" />
        <TextBox x:Name="txtRoute_Port"
            HorizontalAlignment="Left"
            Margin="911,51,0,0"
            TextWrapping="Wrap"
            Text="20001"
            VerticalAlignment="Top" Visibility="Hidden"
            Width="95" />
        <Label Content="路由单元"
            HorizontalAlignment="Left"
            Margin="852,2,0,0"
            VerticalAlignment="Top" Visibility="Hidden"
            Width="61" />
        <TextBox x:Name="txtRouteName"
            HorizontalAlignment="Left"
            Margin="911,7,0,0"
            TextWrapping="Wrap"
            Text="A1"
            VerticalAlignment="Top" Visibility="Hidden"
            Width="95" />
        <Label Content="主备ID"
            HorizontalAlignment="Left" ToolTip="内存服务器"
            Margin="852,2,0,0"
            VerticalAlignment="Top" 
            Width="61" />
        <TextBox x:Name="txtActiveAndsandby"
            HorizontalAlignment="Left"
            Margin="911,7,0,0"
            TextWrapping="Wrap" ToolTip="clientid为主备"
            Text="C1,C2"
            VerticalAlignment="Top" 
            Width="95" />
        <Label Content="交主备ID"
            HorizontalAlignment="Left" ToolTip="交易服务器"
            Margin="849,37,0,0"
            VerticalAlignment="Top" 
            Width="59" />
        <TextBox x:Name="txtActiveAndsandbyTrade"
            HorizontalAlignment="Left"
            Margin="911,41,0,0"
            TextWrapping="Wrap" ToolTip="clientid为主备"
            Text="T1,T2"
            VerticalAlignment="Top" 
            Width="95" Height="18" />
        <Button x:Name="btnSendPush_Copy"
            Content="推送(All)"  Background="LightBlue" ToolTip="MType: 0:old 消息类,1:批量类,2:内存 通用,3:内存 交易 " 
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Width="61"
            Margin="439,15,0,0"
            Height="50"
            Click="btnSendPush_Copy_Click" />

        <!--<Button x:Name="btnSendPush_Cache"
            Content="推送Cache包"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Width="57"
            FontSize="8"
            Margin="604,14,0,0"
            Height="50"
            Click="btnSendPush_Cache_Click" />-->
    </Grid>
</Window>
